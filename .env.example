# Copiez ce fichier en .env et remplissez vos clés API.
# IMPORTANT : sur la plateforme, créez une clé SANS droit de retrait (withdraw).
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Certaines plateformes (ex: OKX, KuCoin) demandent aussi une passphrase
EXCHANGE_API_PASSWORD=

# Pilotage depuis le téléphone (Telegram) - voir README, section « Sur votre téléphone »
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
